# Copy to .env and fill in. Required.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Which price rule is allowed to trigger. Both are always shown in the message.
#   daily    CMP vs yesterday's close. What Screener's "1day return %", NSE, BSE
#            and Google Finance all quote, so you can cross-check it anywhere.
#   intraday CMP vs today's open, excluding the overnight gap.
# Use "daily,intraday" for both.
PRICE_RULES=daily

# Price levels, in percent. 5 is the only default; a 3% band was too noisy.
# Set 3,5 to bring the first level back.
MOVE_LEVELS=5
# Volume levels, as a multiple of the 5-day average. Empty means volume never
# raises an alert; it still appears inside price alerts as context. With ~300
# names a 1.5x threshold was crossed by 16% of the universe on an ordinary day
# and 47% on an index-rebalance day, which reports the market, not a stock.
# Set e.g. 2.5,4 to turn the trigger back on at a selective level.
VOLUME_LEVELS=

# How far a reading must fall back before that level can fire again. At 0.1 a
# stock easing to 4.9% and pushing through 5% again is reported again, while one
# hovering on 4.999/5.001 is not.
REARM_MARGIN_PCT=0.1
VOLUME_REARM_MARGIN=0.1

# Completed sessions averaged for the volume baseline.
BASELINE_SESSIONS=5

# Scale today's volume by the share of a day that normally trades by this time,
# so a morning surge is visible in the morning. Set false for the raw
# cumulative-vs-full-day comparison the tracker uses.
VOLUME_PACING=true
# Sessions used for the shape of the intraday curve. Wider than the baseline on
# purpose, so one expiry day's huge close cannot distort it.
PROFILE_SESSIONS=10
# Stay quiet until this much of a normal day has traded; projecting a whole day
# from the first few minutes divides by almost nothing.
MIN_PROFILE_FRACTION=0.03

# Price alerts at or above this level are followed by the company's named
# shareholders from BSE, as a second message. Set to 0 to switch it off.
SHAREHOLDING_AT_PCT=5
# Holders listed individually. 0 = all of them, which is the default; the note is
# only shortened if it would breach Telegram's 4,096-character limit.
SHAREHOLDING_PROMOTERS=0
SHAREHOLDING_PUBLIC_HOLDERS=0
# Optional ceiling on shareholding notes per day. 0 = no limit, so every name
# that crosses the level gets one.
SHAREHOLDING_MAX_PER_DAY=0
# A pattern is as-of its quarter end, so block/bulk deals printed since then are
# applied in share counts to restate each holder. False reports the raw pattern.
POST_SHP_ADJUSTMENT=true

# Flag, but still send, a move this large: more likely bad data or an unadjusted
# corporate action than a real price change.
IMPLAUSIBLE_MOVE_PCT=25
# Warn when this share of the universe cannot be priced, so silence is never
# mistaken for a calm market.
BLIND_WARNING_SHARE=0.5

# Only used when running as a long-lived process, not on a schedule.
POLL_SECONDS=60
QUOTE_WORKERS=8

SEND_OPEN_PING=true
SEND_CLOSE_DIGEST=true
